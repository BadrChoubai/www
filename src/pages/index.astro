---
import { getCollection } from "astro:content";
export const prerender = false;

let allPosts = await getCollection("blog");
allPosts = allPosts.filter((post) => !post.data.draft);

import Layout from "../layouts/Layout.astro";
import Hero from "../sections/Hero.astro";
import Section from "../components/Section.astro";
import PostCard from "../components/PostCard.astro";
---

<Layout description="What I Do.">
  <Hero />

  <Section class="section--height-1/3" id="about-me">
    <div class="about-inner">
      <div class="about-left">
        <header class="group">
          <h2>Software Engineer.<br />Mostly Outdoors.</h2>
          <p>bits about me.</p>
        </header>
        <ul class="grid" style="padding-left: 0;">
            {allPosts.map((post) => <PostCard {post} />)}
        </ul>
    </Section>

    <style>
        .about-inner {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2.5rem;
            padding: 1rem 0;
        }

        @media (min-width: 750px) {
            .about-inner {
                grid-template-columns: 1fr 1.4fr;
                gap: 4rem;
                align-items: start;
            }
        }

        /* Left column */
        .about-left {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .about-heading {
            font-size: clamp(1.6rem, 3.5vw, 2.4rem);
            font-weight: 900;
            line-height: 1.1;
            letter-spacing: -0.03em;
            color: var(--white);
            margin-bottom: 0;
        }

        .about-stats {
            display: flex;
            gap: 2rem;
            border-top: var(--app-border-width) solid var(--app-border-color);
            padding-top: 1.5rem;
        }

        .stat {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .stat-value {
            font-size: 1.8rem;
            font-weight: 900;
            line-height: 1;
            color: var(--orange--lighten);
            font-family: var(--app-font-family-monospace);
        }

        .stat-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: rgba(255, 255, 255, 0.4);
            font-family: var(--app-font-family-monospace);
        }

        /* Right column */
        .about-right {
            display: flex;
            flex-direction: column;
        }

        .about-lead {
            background-color: var(--app-background-color--contrast);
            border-left: var(--app-border-width) solid var(--app-accent-color);
        }

        .about-lead p {
            margin: 0 0;
        }

        .about-cta {
            margin-top: 0.5rem;
        }

        .btn-accent {
            font-family: var(--app-font-family-monospace);
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--app-accent-color);
            border-bottom: 1px solid var(--app-accent-color);
            padding-bottom: 0.15rem;
            transition:
                color var(--app-transition),
                border-color var(--app-transition);
        }
        .btn-accent:hover {
            color: var(--app-accent-color--hover);
            border-color: var(--app-accent-color--hover);
        }
    </style>
</Layout>
