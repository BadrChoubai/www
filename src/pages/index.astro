---
import { getCollection } from "astro:content";
export const prerender = false;

let allPosts = await getCollection("blog");
allPosts = allPosts.filter((post) => !post.data.draft);

import Layout from "../layouts/Layout.astro";
import Hero from "../sections/Hero.astro";
import Section from "../components/Section.astro";
import PostCard from "../components/PostCard.astro";

import { Content as AboutMeCopy } from "../content/copy/about-me.md";
---

<Layout description="What I Do.">
  <Hero />

  <Section id="about-me">
    <div class="about-content">
      <header class="about-header">
        <h2 class="h1">About Me</h2>
      </header>
      <div class="about-stats">
        <div class="stat">
          <span class="stat-value">B.Sc.</span>
          <span class="stat-label">In progress</span>
        </div>
        <div class="stat">
          <span class="stat-value">2+</span>
          <span class="stat-label">Years in industry</span>
        </div>
      </div>
      <AboutMeCopy />
    </div>
  </Section>
  <Section class="contrast" id="recent-posts">
    <header class="group">
      <h2>Recent Posts</h2>
    </header>
    <ul class="grid" style="padding-left: 0;">
      {allPosts.map((post) => <PostCard {post} />)}
    </ul>
  </Section>
</Layout>

<style>
  .about-content {
    display: flex;
    padding: 1rem 0;
    flex-direction: column;
    gap: var(--app-spacing);
  }
  .about-stats {
    display: flex;
    gap: var(--app-spacing);
    border-top: var(--app-border-width) solid var(--app-border-color);
    padding-top: 0.2rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    font-family: "Host Grotesk Variable", sans-serif;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .stat-value {
    font-size: 2rem;
    color: var(--orange--lighten);
  }

  .stat-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--gray-200);
  }
</style>
