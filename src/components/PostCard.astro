---
const { post } = Astro.props;
---

<li class="post-card">
    <div>
        <header class="group">
            <h3>
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            <p>{post.data.published.toLocaleDateString()}</p>
        </header>
        <p>{post.data.description}</p>
        <div class="tags-container">
            {post.data.tags.map((tag: string) => <i class="tag">{tag}</i>)}
        </div>
    </div>
</li>

<style>
    .post-card {
        list-style: none;
        background-color: var(--app-surface-color--opaque);
        padding: 1rem;
        border: var(--app-border-width) solid var(--app-border-color);
        box-shadow: var(--app-box-shadow);
        transition: box-shadow var(--app-transition);
    }

    .post-card:hover {
        box-shadow: var(--app-box-shadow--hover);
    }

    .post-card header {
        display: flex;
        flex-direction: column;
        align-items: start;
    }

    .tags-container {
        display: flex;
        flex-direction: row;
        gap: var(--app-spacing);
    }

    .tag {
        font-weight: 600;
        color: var(--app-accent-color);
    }
</style>
